# Copy this file to .env and fill in real values.
# Generate values with: node scripts/generate-admin-credentials.cjs
# (or any tool that can produce a random salt + SHA-256 hashes)

VITE_ADMIN_ROUTE=change-me-to-a-random-string
VITE_ADMIN_SALT=change-me-to-a-random-hex-string
VITE_ADMIN_USER_HASH=sha256_of__salt_colon_USR_colon_username
VITE_ADMIN_PASS_HASH=sha256_of__salt_colon_PWD_colon_password

# PBKDF2 application pepper used to hash regular user passwords.
# Rotating this value invalidates every existing user-password hash.
VITE_USER_AUTH_SALT=change-me-to-a-random-32-byte-hex-string
